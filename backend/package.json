{
  "name": "portfolio-fotografico-backend",
  "version": "1.0.0",
  "description": "Backend per portfolio fotografico",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test src/config/*.test.js src/middleware/*.test.js src/services/*.test.js src/repositories/*.test.js src/utils/*.test.js",
    "db:migrate": "node scripts/migrate-postgres.js",
    "metadata:validate": "node scripts/import-metadata-postgres.js --dry-run",
    "metadata:import": "node scripts/import-metadata-postgres.js",
    "token:hash": "node scripts/hash-write-token.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.862.0",
    "@aws-sdk/s3-request-presigner": "^3.862.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.6.0",
    "helmet": "^6.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  },
  "keywords": [
    "photography",
    "portfolio",
    "nodejs",
    "express"
  ],
  "author": "Kevin",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
