{
  "name": "portfolio-fotografico",
  "version": "1.0.0",
  "description": "Un moderno portfolio fotografico con mappa interattiva",
  "main": "index.js",
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm start",
    "build": "npm install --prefix frontend && CI=false npm run build --prefix frontend",
    "vercel-build": "npm install --prefix backend && npm run build",
    "branding": "node frontend/scripts/apply-branding.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && CI=true npm test -- --watchAll=false --passWithNoTests",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "echo \"No backend lint configured\"",
    "lint:frontend": "npm --prefix frontend exec eslint frontend/src",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "cd backend && rm -rf node_modules",
    "clean:frontend": "cd frontend && rm -rf node_modules"
  },
  "keywords": [
    "photography",
    "portfolio",
    "react",
    "nodejs",
    "leaflet",
    "map"
  ],
  "author": "Kevin",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/03kev/portfolio-fotografico.git"
  },
  "bugs": {
    "url": "https://github.com/03kev/portfolio-fotografico/issues"
  },
  "homepage": "https://github.com/03kev/portfolio-fotografico#readme"
}
