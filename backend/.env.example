# Runtime (locale)
PORT=5001 # Porta backend locale (su Vercel non serve).
NODE_ENV=development # Ambiente locale: development | production.
SITE_URL= # URL pubblico canonico backend (senza slash finale).

# Metadata persistence
METADATA_BACKEND=postgres # Target corrente. json resta per lettura/export/rollback: upload, media e delete foto richiedono Postgres.
# Interruttore globale delle mutazioni metadata/media. Se omesso, il backend usa true:
# dichiaralo quindi sempre esplicitamente negli ambienti distribuiti.
# false = letture abilitate, operazioni admin mutanti e cleanup R2 bloccati.
# true = scritture abilitate; su Vercel Preview richiede anche un R2_OBJECT_PREFIX
# non vuoto e isolato da Production.
METADATA_WRITES_ENABLED=true # Locale scrivibile; usa false per Preview/staging read-only.
DATABASE_URL= # Connessione Postgres pooled usata a runtime (fornita dall'integrazione Vercel/Neon).
DATABASE_URL_UNPOOLED= # Connessione Postgres diretta usata da migration/import (fornita da Vercel/Neon).
TEST_DATABASE_URL= # Database/branch Neon isolato usato esclusivamente dai test di integrazione.
DATABASE_POOL_MAX=5 # Connessioni massime per istanza serverless.

# Su Vercel usa DATABASE_URL e DATABASE_URL_UNPOOLED con scope specifico per
# ciascun branch Preview (per esempio feature/database o develop). Eventuali
# STAGING_DATABASE_URL* sono alias locali per operazioni manuali e non vengono
# letti automaticamente dal runtime applicativo.

# CORS
CORS_ORIGINS= # Origins consentite, separate da virgola (obbligatoria anche in development).

# Admin auth (obbligatorio in produzione)
API_WRITE_TOKEN_HASH=scrypt$16384$8$1$... # Hash scrypt del token admin (usa: npm run token:hash -- "<token>").
API_WRITE_TOKEN= # Fallback DEV opzionale (in produzione lascia vuoto).
API_SESSION_SECRET=change_me_with_another_long_random_secret # Segreto firma cookie sessione (separato dal token).
CRON_SECRET=change_me_with_a_random_cron_secret # Bearer usato da Vercel Cron per il cleanup media durevole.
API_SESSION_COOKIE_NAME= # Opzionale: nome cookie sessione admin.
API_SESSION_TTL_MS=604800000 # Durata sessione in ms (default: 7 giorni).
API_AUTH_RATE_LIMIT_WINDOW_MS=600000 # Finestra rate limit login sessione (ms).
API_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10 # Tentativi massimi login sessione nella finestra.

# Cloudflare R2 (obbligatorio: backend R2-only in tutti gli ambienti)
R2_ACCOUNT_ID=your_cloudflare_account_id # Cloudflare Account ID.
R2_ACCESS_KEY_ID=your_r2_access_key_id # Access key R2 (S3 API).
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key # Secret key R2 (S3 API).
R2_BUCKET=portfolio-images # Nome bucket R2.
R2_PRIVATE_BUCKET=portfolio-images-private # Bucket privato per source full-res (consigliato separato).
R2_PUBLIC_URL=https://uploads.yourdomain.com # Base URL pubblica asset (es. custom domain R2).
R2_ENDPOINT= # Opzionale: endpoint S3 custom; default https://<accountid>.r2.cloudflarestorage.com.
R2_OBJECT_PREFIX= # Vuoto in Production/Preview read-only; obbligatorio e isolato nelle Preview scrivibili.
R2_METADATA_PREFIX=data # Prefisso/cartella metadati su R2 (es. data).
