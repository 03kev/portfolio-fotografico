# Server
PORT=5001

# Environment
NODE_ENV=development

# API Write Auth
# Token admin per aprire sessione cookie HttpOnly (e per chiamate API server-to-server via header).
# In produzione è obbligatorio.
API_WRITE_TOKEN=change_me_with_a_long_random_token
# Segreto firma sessione (consigliato separato da API_WRITE_TOKEN)
API_SESSION_SECRET=change_me_with_another_long_random_secret
# Durata sessione cookie (default 7 giorni)
API_SESSION_TTL_MS=604800000

# Upload Configuration
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_TYPES=image/*

# Cloudflare R2
# In produzione è obbligatorio (backend R2-only).
# In sviluppo, senza queste variabili viene usato fallback locale.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=portfolio-images
R2_PUBLIC_URL=https://images.yourdomain.com

# CORS Origins (separati da virgola)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=500
